# What `python -m build` puts in the SOURCE distribution. The wheel carries only
# the `assaywatch` package (see [tool.setuptools.packages.find] in pyproject.toml);
# the sdist additionally carries what is needed to run the test suite and read the
# registry, so an sdist is a self-contained copy of the project.
#
# The prunes are the point of this file. `papers/` holds copyrighted PDFs that
# must never be redistributed, `.secrets/` holds API keys, and `data/` and
# `results/` are gigabytes of derived scratch (6.6 GB and 485 MB on the machine
# this was written on). None of them are tracked by git, but sdist assembly does
# not read .gitignore, so they are excluded here explicitly rather than by luck.

include README.md CONTRIBUTING.md ROADMAP.md CLAUDE.md
include CITATION.cff
include pyproject.toml environment.yml config.yaml Snakefile MANIFEST.in
include .pre-commit-config.yaml

recursive-include assaywatch *.py
recursive-include registry *.yaml
recursive-include tests *.py
recursive-include scripts *.py
recursive-include profiles *
recursive-include docs *.md *.tsv
recursive-include examples *.py *.md *.fasta

prune papers
prune data
prune results
prune .secrets
prune .snakemake
prune build
prune dist

exclude *.key
global-exclude __pycache__ *.py[cod] .DS_Store *.orig *.rej
