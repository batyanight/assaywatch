digraph snakemake_dag {
    graph[bgcolor=white, margin=0];
    node[shape=box, style=rounded, fontname=sans,                 fontsize=10, penwidth=2];
    edge[penwidth=2, color=grey];
	0[label = "all", color = "0.00 0.6 0.85", style="rounded"];
	1[label = "report", color = "0.30 0.6 0.85", style="rounded"];
	2[label = "collect_calls", color = "0.07 0.6 0.85", style="rounded"];
	3[label = "retrieve", color = "0.37 0.6 0.85", style="rounded"];
	4[label = "validate", color = "0.59 0.6 0.85", style="rounded"];
	5[label = "degeneracy_table", color = "0.15 0.6 0.85", style="rounded"];
	6[label = "site_drift", color = "0.52 0.6 0.85", style="rounded"];
	7[label = "lineage_analysis", color = "0.22 0.6 0.85", style="rounded"];
	5 -> 0
	7 -> 0
	6 -> 0
	1 -> 0
	2 -> 1
	3 -> 2
	4 -> 3
	4 -> 5
	2 -> 6
	2 -> 7
}            
