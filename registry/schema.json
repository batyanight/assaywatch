    "ReviewFlag": {
      "description": "Every value `needs_review[].flag` may take.\n\nAdding one is a deliberate act: it must be a category a filter would ask\nfor, not one entry's story. If it would only ever apply to a single assay,\nit is a `note` on a broader flag, or it is `curation_decision_pending`.",
      "enum": [
        "citation_unresolved",
        "oligo_source_unresolved",
        "oligo_sequence_uncertain",
        "amplicon_size_unresolved",
        "target_scope_unresolved",
        "duplicate_entry_unresolved",
        "do_not_use",
        "not_validated",
        "retrieval_stale",
        "curation_decision_pending",
        "oligos_modified",
        "oligos_from_secondary_source",
        "oligos_read_from_figure",
        "oligos_not_in_cited_paper",
        "citation_is_indirect",
        "orientation_inferred",
        "pairing_is_curator_reading",
        "amplicon_measured_not_published",
        "amplicon_disagrees_with_paper",
        "amplicon_multimodal",
        "cross_reactive",
        "scope_narrower_than_taxid",
        "retrieval_scope_incomplete",
        "nested_protocol",
        "shares_oligos_with_sibling",
        "pooled_as_one_assay",
        "primer_site_polymorphic",
        "thin_evidence",
        "not_screenable",
        "target_annotation_uncertain",
        "chemistry_detail_missing"
      ],
      "title": "ReviewFlag",
      "type": "string"
    },
    "ReviewItem": {
      "additionalProperties": false,
      "description": "One review flag, with the one line of prose that makes it actionable.\n\nThe vocabulary, and which flags are open questions rather than recorded\ncaveats, live in `assaywatch.review`; read that module's docstring before\nadding a flag.",
      "properties": {
